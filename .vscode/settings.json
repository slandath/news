{
  // golang.go formats Go files with gofmt and organizes imports on save.
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },

  // a-h.templ formats .templ files via the templ CLI.
  "[templ]": {
    "editor.defaultFormatter": "a-h.templ"
  }
}
