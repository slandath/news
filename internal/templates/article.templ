package templates

templ Article(props ArticleProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ props.Title }</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/purecss@3.1.0/build/pure-min.css"/>
			@SiteStyle()
		</head>
		<body>
			<div class="wrap">
				<header>
					<nav class="pure-menu pure-menu-horizontal crumb-nav" aria-label="breadcrumbs">
						<ul class="pure-menu-list">
							<li class="pure-menu-item"><a class="pure-menu-link" href="/">Home</a></li>
							if props.FeedHref != "" {
								<li class="pure-menu-item"><a class="pure-menu-link" href={ props.FeedHref }>{ props.FeedTitle }</a></li>
							}
							<li class="pure-menu-item pure-menu-selected"><a class="pure-menu-link" href="#" aria-current="page">{ truncate(props.Title, 30) }</a></li>
						</ul>
					</nav>
				</header>
			</div>
			<main>
				<section class="banner">
					<div class="wrap">
						<p class="banner-title">{ truncate(props.Title, 60) }</p>
					</div>
				</section>
				<section class="wrap narrow">
					<div>
						for _, para := range props.Paragraphs {
							<p class="para">{ para }</p>
						}
						<div>
							<a href={ props.SourceURL } class="source-link" target="_blank">Source</a>
						</div>
					</div>
				</section>
			</main>
		</body>
	</html>
}
