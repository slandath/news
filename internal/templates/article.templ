package templates

templ Article(props ArticleProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ props.Title }</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/purecss@3.1.0/build/pure-min.css"/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/purecss@3.1.0/build/grids-responsive-min.css"/>
			@SiteStyle()
		</head>
		<body>
			@PageHeader("Article")
			<main class="wrap narrow">
				<article class="article">
					<h1>{ truncate(props.Title, 60) }</h1>
					if props.FeedHref != "" {
						<p class="meta">From <a href={ props.FeedHref }>{ props.FeedTitle }</a></p>
					}
					for _, para := range props.Paragraphs {
						<p class="para">{ para }</p>
					}
					<div class="source-row">
						<a href={ props.SourceURL } class="pure-button" target="_blank">Source</a>
					</div>
				</article>
			</main>
		</body>
	</html>
}
