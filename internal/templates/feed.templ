package templates

templ Feed(props FeedProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ props.Title }</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/purecss@3.1.0/build/pure-min.css"/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/purecss@3.1.0/build/grids-responsive-min.css"/>
			@SiteStyle()
		</head>
		<body>
			@PageHeader(props.Title)
			<main class="wrap">
				<h1 class="page-title">{ props.Title }</h1>
				<section id="content">
					<ul class="feed-list">
						for _, item := range props.Items {
							<li class="feed-item pure-g">
								<div class="pure-u-1 pure-u-md-3-4">
									if item.Href != "" {
										<a href={ item.Href }>{ item.Title }</a>
									} else {
										{ item.Title }
									}
								</div>
								<div class="pure-u-1 pure-u-md-1-4 date-col">
									<p class="pubdate">{ item.Published }</p>
								</div>
							</li>
						}
					</ul>
				</section>
			</main>
		</body>
	</html>
}
