package templates

templ Home(props HomeProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Tom's News</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/purecss@3.1.0/build/pure-min.css"/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/purecss@3.1.0/build/grids-responsive-min.css"/>
			@SiteStyle()
		</head>
		<body>
			@PageHeader("Feeds")
			<main class="wrap">
				<h1 class="page-title">News Feeds</h1>
				for _, feed := range props.Feeds {
					<div class="feed-card">
						<a href={ feed.Href }>
							{ feed.Title }
						</a>
					</div>
				}
			</main>
		</body>
	</html>
}
