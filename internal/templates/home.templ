package templates

templ Home(props HomeProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Tom's News</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/purecss@3.1.0/build/pure-min.css"/>
			@SiteStyle()
		</head>
		<body>
			<div class="wrap">
				<header>
					<nav class="pure-menu pure-menu-horizontal crumb-nav" aria-label="breadcrumbs">
						<ul class="pure-menu-list">
							<li class="pure-menu-item pure-menu-selected"><a class="pure-menu-link" href="/" aria-current="page">Home</a></li>
						</ul>
					</nav>
				</header>
			</div>
			<section class="banner">
				<div class="wrap">
					<p class="banner-title">News Feeds</p>
				</div>
			</section>
			<div class="wrap">
				<ul class="feed-list">
					for _, feed := range props.Feeds {
						<li class="feed-item">
							<a href={ feed.Href }>
								{ feed.Title }
							</a>
						</li>
					}
				</ul>
			</div>
		</body>
	</html>
}
