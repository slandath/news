package templates

templ Home(props HomeProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Tom's News</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/purecss@3.1.0/build/pure-min.css"/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/purecss@3.1.0/build/grids-responsive-min.css"/>
			@SiteStyle()
		</head>
		<body>
			@PageHeader("Feeds")
			<main class="wrap">
				<h1 class="page-title">News Feeds</h1>
				<p class="meta"><a href="/add">Add a feed</a></p>
				for _, section := range props.Sections {
					<h2 class="section-title">{ section.Title }</h2>
					<ul class="feed-cards">
						for _, feed := range section.Feeds {
							<li class="feed-card">
								<a href={ feed.Href }>
									{ feed.Title }
								</a>
							</li>
						}
					</ul>
				}
			</main>
		</body>
	</html>
}
