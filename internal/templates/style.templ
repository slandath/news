package templates

// SiteStyle is the small shared layer on top of Pure CSS: the Harbor
// palette, the header bar, content widths, cards, list rows, and ellipsis.
// Flat colors only, no gradients.
templ SiteStyle() {
	<style>
		body {
			font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
			color: #1c2733;
			background: #e9edf1;
		}
		a { color: #0b5cad; }
		.wrap { max-width: 960px; margin: 0 auto; padding: 0 1em; }
		.wrap.narrow { max-width: 44em; }
		.topbar { background: #15324c; }
		.topnav { padding-top: 0.4em; padding-bottom: 0.4em; }
		.topnav .pure-menu-heading { color: #fff; text-transform: none; font-size: 1.1em; }
		.topnav .pure-menu-link { color: #cdd8e2; }
		.topnav .pure-menu-link:hover, .topnav .pure-menu-link:focus { background: transparent; color: #fff; }
		.topnav .pure-menu-selected { border-bottom: 3px solid #c98a12; }
		.topnav .pure-menu-selected .pure-menu-link { color: #fff; }
		.page-title { margin: 1em 0 0.5em; font-size: 1.75em; }
		.feed-cards { margin: 0 0 2em; padding: 0; list-style: none; }
		.feed-card { background: #fff; border: 1px solid #d9e0e8; border-radius: 6px; padding: 1em 1.25em; margin: 0 0 1em; }
		.feed-card a { font-size: 1.1em; }
		.feed-list { list-style: none; margin: 0 0 2em; padding: 0 1.25em; background: #fff; border: 1px solid #d9e0e8; border-radius: 6px; }
		.feed-item { padding: 0.9em 0; border-bottom: 1px solid #d9e0e8; }
		.feed-item:last-child { border-bottom: none; }
		.pubdate { color: #5a6b7c; font-size: 0.875em; margin: 0.25em 0 0; }
		@media (min-width: 48em) {
			.date-col { text-align: right; }
		}
		.article { background: #fff; border: 1px solid #d9e0e8; border-radius: 6px; padding: 1.5em 1.5em 2em; margin: 1em 0 2em; }
		.article h1 { margin-top: 0; font-size: 1.75em; }
		.meta { color: #5a6b7c; margin: 0 0 1.25em; }
		.para { margin: 0 0 1em; line-height: 1.6; }
		.source-row { margin-top: 1.5em; }
		.error-card { background: #fff; border: 1px solid #d9e0e8; border-radius: 6px; padding: 2em; margin: 2em auto; max-width: 36em; text-align: center; }
		.truncate {
			display: inline-block;
			max-width: 100%;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
			vertical-align: bottom;
		}
	</style>
}
