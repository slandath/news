package templates

// PageHeader is the single shared header: the brand links home, the
// section label names the current page, and an "Add a feed" link sits at
// the right of the bar. There are no breadcrumb trails; the label is plain
// text, never a link. The add link is omitted on the add page itself,
// where the label already names it.
templ PageHeader(label string) {
	<header class="topbar">
		<nav class="wrap pure-menu pure-menu-horizontal topnav" aria-label="Site">
			<a href="/" class="pure-menu-heading pure-menu-link">Tom's News</a>
			<ul class="pure-menu-list">
				<li class="pure-menu-item pure-menu-selected">
					<span class="pure-menu-link" aria-current="page">{ label }</span>
				</li>
				if label != "Add a feed" {
					<li class="pure-menu-item nav-add">
						<a href="/add" class="pure-menu-link">Add a feed</a>
					</li>
				}
			</ul>
		</nav>
	</header>
}
