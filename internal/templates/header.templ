package templates

// PageHeader is the single shared header: the brand links home and the
// section label names the current page. There are no breadcrumb trails;
// the label is plain text, never a link.
templ PageHeader(label string) {
	<header class="topbar">
		<nav class="wrap pure-menu pure-menu-horizontal topnav" aria-label="Site">
			<a href="/" class="pure-menu-heading pure-menu-link">Tom's News</a>
			<ul class="pure-menu-list">
				<li class="pure-menu-item pure-menu-selected">
					<span class="pure-menu-link" aria-current="page">{ label }</span>
				</li>
			</ul>
		</nav>
	</header>
}
