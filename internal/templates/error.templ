package templates

templ Error(props ErrorProps) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="color-scheme" content="light"/>
			<title>Error</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/purecss@3.1.0/build/pure-min.css"/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/purecss@3.1.0/build/grids-responsive-min.css"/>
			@SiteStyle()
		</head>
		<body>
			@PageHeader("Error")
			<div class="wrap">
				<main role="main">
					<section class="error-card">
						<h1>{ props.Title }</h1>
						<p class="para">{ props.Message }</p>
						<p><a class="pure-button pure-button-primary" href="/">Back to feeds</a></p>
					</section>
				</main>
			</div>
		</body>
	</html>
}
